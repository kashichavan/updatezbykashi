# Kashii Updatez - Production Deployment Environment Sample
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=false
ALLOWED_HOSTS=kashiiupdatez.com,*.onrender.com,*.railway.app,localhost,127.0.0.1
DATABASE_URL=postgres://user:password@host:5432/dbname
CSRF_TRUSTED_ORIGINS=https://kashiiupdatez.com,https://*.onrender.com

# Optional: makes "Find people" on the recruiter page work reliably.
# Serper gives real LinkedIn search results. GitHub raises the search rate limit.
SERPER_API_KEY=
GITHUB_TOKEN=

# --- SEO & analytics (optional; each tag renders only when its ID is set and valid) ---
# GA4 measurement ID from analytics.google.com > Admin > Data streams, e.g. G-AB12CD34EF
GA_MEASUREMENT_ID=
# Microsoft Clarity project ID from clarity.microsoft.com > Settings > Overview
CLARITY_PROJECT_ID=
# Google Search Console "HTML tag" verification token (only the content="..." value)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 token (only the content="..." value)
BING_SITE_VERIFICATION=

# --- Job sources ---
# Adzuna official India job search API (free key: https://developer.adzuna.com). Off unless both are set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Official employer career boards (Greenhouse/Lever/Ashby/SmartRecruiters) listed in
# requirements/job_aggregator/career_boards.json. Boards processed per 15-min cycle:
CAREER_BOARDS_PER_RUN=4
