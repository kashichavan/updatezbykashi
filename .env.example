# Kashii Updatez - Production Deployment Environment Sample
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=false
ALLOWED_HOSTS=kashiiupdatez.com,*.onrender.com,*.railway.app,localhost,127.0.0.1
DATABASE_URL=postgres://user:password@host:5432/dbname
CSRF_TRUSTED_ORIGINS=https://kashiiupdatez.com,https://*.onrender.com

# Optional: makes "Find people" on the recruiter page work reliably.
# Serper gives real LinkedIn search results. GitHub raises the search rate limit.
SERPER_API_KEY=
GITHUB_TOKEN=
